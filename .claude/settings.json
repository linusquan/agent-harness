{
  "permissions": {
    "allow": [
      "Agent(planner)",
      "Agent(builder)",
      "Agent(checker)",
      "Bash(./scripts/notify.sh:*)",
      "Bash(echo $HARNESS_MODE:*)",
      "Read(src/.artifacts/**)",
      "Read(roles/**)",
      "Read(.claude/agents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/guard-docker-stack.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/guard-docker-stack.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "planner|builder|checker",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/on-subagent-stop.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
